CREATE TABLE account (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE,
    starting_centavos INTEGER NOT NULL DEFAULT 0,
    archived INTEGER NOT NULL DEFAULT 0
);

insert:
INSERT INTO account(name, starting_centavos) VALUES (?, ?);

lastId:
SELECT last_insert_rowid();

-- Starting balance + money in - money out. Never stored, always computed.
balanceOf:
SELECT CAST(a.starting_centavos + COALESCE(SUM(
    CASE
        WHEN t.kind = 'INCOME'   AND t.account_id    = a.id THEN  t.centavos
        WHEN t.kind = 'EXPENSE'  AND t.account_id    = a.id THEN -t.centavos
        WHEN t.kind = 'TRANSFER' AND t.account_id    = a.id THEN -t.centavos
        WHEN t.kind = 'TRANSFER' AND t.to_account_id = a.id THEN  t.centavos
        ELSE 0
    END
), 0) AS INTEGER) AS balance
FROM account a
LEFT JOIN txn t ON t.account_id = a.id OR t.to_account_id = a.id
WHERE a.id = ?
GROUP BY a.id;

countAll:
SELECT COUNT(*) FROM account;

active:
SELECT id, name FROM account
WHERE archived = 0
ORDER BY id;

balances:
SELECT a.id, a.name, CAST(a.starting_centavos + COALESCE(SUM(
    CASE
        WHEN t.kind = 'INCOME'   AND t.account_id    = a.id THEN  t.centavos
        WHEN t.kind = 'EXPENSE'  AND t.account_id    = a.id THEN -t.centavos
        WHEN t.kind = 'TRANSFER' AND t.account_id    = a.id THEN -t.centavos
        WHEN t.kind = 'TRANSFER' AND t.to_account_id = a.id THEN  t.centavos
        ELSE 0
    END
), 0) AS INTEGER) AS balance
FROM account a
LEFT JOIN txn t ON t.account_id = a.id OR t.to_account_id = a.id
WHERE a.archived = 0
GROUP BY a.id
ORDER BY a.id;